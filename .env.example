# === Notion ===
# Internal integration token (https://www.notion.so/my-integrations).
# The integration must be shared with the "Personal Knowledge OS" page.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs default to the discovered "Personal Knowledge OS" databases.
# Override only if you point the pipeline at a different workspace.
NOTION_INBOX_DB=977c9481-f47e-4892-8b84-24a8236831aa
NOTION_CONCEPTS_DB=3db62bfa-b693-4159-8bc9-211e719607c7
NOTION_ENTITIES_DB=9f4b16da-8894-4c95-86a9-28dae22a1806
NOTION_CLAIMS_DB=3e54f8ff-cebe-45e4-a5ed-90c0ca990c4e

# === OpenAI ===
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any model that supports Structured Outputs (json_schema strict mode).
OPENAI_MODEL=gpt-4o

# === Pipeline tuning ===
# Confidence at or above this value -> Inbox auto-marked 완료, else 검토.
CONFIDENCE_THRESHOLD=0.8
# This machine's worker id (single main-PC worker).
WORKER_ID=main-pc
# Seconds an in-flight item stays leased before another run may reclaim it.
LEASE_SECONDS=900
# Seconds between polls when the queue is empty (run loop).
POLL_INTERVAL=15
# Max automatic retries before an item is marked 실패.
MAX_RETRIES=3
# Max characters of extracted text sent to the model.
MAX_CONTENT_CHARS=24000
